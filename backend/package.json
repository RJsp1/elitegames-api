{
  "name": "elite-games-api",
  "version": "1.0.0",
  "description": "ELITE GAMES API — backend de pagamentos Pix Sicredi para a plataforma ELITE CROSS",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "cert:setup": "tsx scripts/setup-certificates.ts",
    "cert:check": "tsx scripts/check-certificates.ts",
    "sicredi:mtls": "tsx scripts/test-mtls.ts",
    "sicredi:token": "tsx scripts/test-sicredi-token.ts",
    "sicredi:charge": "tsx scripts/create-test-charge.ts",
    "sicredi:check-charge": "tsx scripts/check-sicredi-charge.ts",
    "sicredi:webhook": "tsx scripts/register-webhook.ts",
    "sicredi:create-persisted-payment": "tsx scripts/create-persisted-payment.ts",
    "supabase:test": "tsx scripts/test-supabase-connection.ts",
    "worker:reconciliation": "tsx scripts/start-reconciliation-worker.ts",
    "worker:reconciliation:prod": "node dist/scripts/start-reconciliation-worker.js"
  },
  "keywords": [
    "pix",
    "sicredi",
    "elite-games",
    "elite-cross"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
